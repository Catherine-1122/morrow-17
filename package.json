{
  "name": "morrow-17",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "npm start",
    "test": "node --test test/*.test.mjs",
